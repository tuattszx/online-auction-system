<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="auction.client.controllers.AuctionDashboardController">
   <children>
      <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <fx:include fx:id="headerMenu" source="Header-menu.fxml" />

            <HBox spacing="20.0" style="-fx-padding: 20;">
               <children>
                  <VBox prefWidth="350.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="%cartview.label.yourbalance" textFill="#888">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <Label fx:id="lbbalance" style="-fx-font-size: 28px; -fx-font-weight: bold;" text="\$1,550" />
                        <Label style="-fx-cursor: hand;" text="%cartview.label.recharge" textFill="#00a854" />
                     </children>
                  </VBox>
                  <VBox prefWidth="350.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label text="%cartview.label.committedexpenses" textFill="#888"><font><Font name="System Bold" size="12.0" /></font></Label>
                              <Region HBox.hgrow="ALWAYS" />
                              <Label text="69%" textFill="#f5a623" />
                           </children>
                        </HBox>
                        <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="\$3,450 / \$5,000" />
                        <Region prefHeight="10.0" />
                        <AnchorPane prefHeight="6.0" style="-fx-background-color: #eee; -fx-background-radius: 5;">
                           <children>
                              <AnchorPane prefHeight="6.0" prefWidth="200.0" style="-fx-background-color: #f5a623; -fx-background-radius: 5;" />
                           </children>
                        </AnchorPane>
                     </children>
                  </VBox>
                  <VBox prefWidth="350.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="%cartview.label.actual" textFill="#888"><font><Font name="System Bold" size="12.0" /></font></Label>
                        <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="\$2,100" />
                        <Label text="%cartview.label.▲12%thisweek" textFill="#00a854" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <VBox spacing="15.0" style="-fx-padding: 0 20 20 20;" stylesheets="@../css/table.css" VBox.vgrow="ALWAYS">
               <children>
                  <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="%cartview.label.auction" />

                  <TableView fx:id="auctionTable" prefHeight="400.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #eee; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" stylesheets="@../css/table.css" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colProduct" prefWidth="300.0" text="%cartview.tablecolumn.PRODUCT" />

                        <TableColumn fx:id="colRemaining" prefWidth="150.0" text="%cartview.tablecolumn.REMAINING" />

                        <TableColumn fx:id="colCurrentBid" prefWidth="150.0" text="%cartview.tablecolumn.CURRENTBID" />

                        <TableColumn fx:id="colYourBid" prefWidth="150.0" text="%cartview.tablecolumn.YOURBID" />

                              <TableColumn fx:id="colStatus" prefWidth="150.0" text="%cartview.tablecolumn.STATUS" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <styleClass>
                        <String fx:value="modern-table" />
                        <String fx:value="btn-action" />
                        <String fx:value="column-header" />
                        <String fx:value="column-header-background" />
                        <String fx:value="label" />
                        <String fx:value="modern-table" />
                        <String fx:value="column-header-background" />
                        <String fx:value="status-label" />
                        <String fx:value="status-losing" />
                        <String fx:value="status-participate" />
                        <String fx:value="status-winning" />
                        <String fx:value="table-row-cell" />
                     </styleClass>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
