<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import org.controlsfx.control.SearchableComboBox?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="auction.client.controllers.ProfileController">
    <stylesheets>
        <URL value="@../css/style.css" />
    </stylesheets>
    <children>
        <BorderPane style="-fx-background-color: #f4f7f6;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <top>
                <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="15.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <padding>
                        <Insets left="30.0" right="30.0" />
                    </padding>
                    <children>
                        <ImageView fitHeight="40.0" fitWidth="100.0" onMouseClicked="#OnMouseBacktoMain" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../img/logo-uet.jpg" /></image>
                            <cursor><Cursor fx:constant="HAND" /></cursor>
                        </ImageView>

                        <Region HBox.hgrow="ALWAYS" />

                        <HBox alignment="CENTER_LEFT" maxHeight="35.0" prefWidth="350.0" style="-fx-background-color: #f0f2f5; -fx-background-radius: 20; -fx-border-color: #e0e0e0; -fx-border-radius: 20;">
                            <children>
                                <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                                    <image><Image url="@../img/search-icon-png-11.png" /></image>
                                    <HBox.margin><Insets left="10.0" /></HBox.margin>
                                </ImageView>
                                <TextField fx:id="txtsearch" promptText="Search items, sellers..." style="-fx-background-color: transparent;" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <Label onMouseClicked="#onSellerClick" style="-fx-text-fill: #0052FF; -fx-font-weight: bold;" text="Become a Seller">
                            <cursor><Cursor fx:constant="HAND" /></cursor>
                        </Label>

                        <HBox spacing="15.0" alignment="CENTER">
                            <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true"><image><Image url="@../img/chuong.jpg" /></image></ImageView>
                            <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true" style="-fx-background-radius: 50;">
                                <image><Image url="@../img/pngtree-blue-user-icon-profile-and-account-vector-design-vector-sign-vector-png-image_46129432.jpg" /></image>
                            </ImageView>
                        </HBox>
                    </children>
                </HBox>
            </top>

            <center>
                <HBox spacing="20.0" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
                    </padding>
                    <children>

                        <VBox minWidth="240.0" prefWidth="240.0" spacing="8.0" style="-fx-background-color: #2c3e50; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 5);">
                            <padding>
                                <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
                            </padding>
                            <children>
                                <HBox fx:id="btnAccount" alignment="CENTER_LEFT" onMouseClicked="#handleSidebarClick" prefHeight="45.0" spacing="15.0" style="-fx-background-radius: 10; -fx-background-color: #3e5871;">
                                    <padding><Insets left="15.0" /></padding>
                                    <children>
                                        <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="Account Settings" />
                                    </children>
                                    <cursor><Cursor fx:constant="HAND" /></cursor>
                                </HBox>

                                <HBox fx:id="btnAddresses" alignment="CENTER_LEFT" onMouseClicked="#handleSidebarClick" prefHeight="45.0" spacing="15.0" style="-fx-background-radius: 10;">
                                    <padding><Insets left="15.0" /></padding>
                                    <children>
                                        <Label style="-fx-text-fill: #bdc3c7;" text="Shipping Addresses" />
                                    </children>
                                    <cursor><Cursor fx:constant="HAND" /></cursor>
                                </HBox>

                                <Region VBox.vgrow="ALWAYS" />

                                <HBox onMouseClicked="#onSignOutClick" prefHeight="45.0" alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-radius: 10; -fx-background-color: #c0392b;">
                                    <padding><Insets left="15.0" /></padding>
                                    <children>
                                        <ImageView fitHeight="18.0" fitWidth="18.0"><image><Image url="@../img/signout.png"/></image></ImageView>
                                        <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="Sign Out" />
                                    </children>
                                    <cursor><Cursor fx:constant="HAND" /></cursor>
                                </HBox>
                            </children>
                        </VBox>

                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" HBox.hgrow="ALWAYS">
                            <content>
                                <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 0);">
                                    <padding>
                                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                                    </padding>
                                    <children>
                                        <Label text="Shipping Addresses" style="-fx-font-size: 24; -fx-font-weight: bold;" />
                                        <Separator />

                                        <GridPane hgap="20.0" vgap="15.0">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                                            </columnConstraints>
                                            <children>
                                                <VBox spacing="5.0">
                                                    <children>
                                                        <Label text="FIRST NAME" textFill="#7f8c8d" style="-fx-font-size: 11; -fx-font-weight: bold;" />
                                                        <TextField prefHeight="40.0" style="-fx-background-color: #f9f9f9; -fx-border-color: #e0e0e0; -fx-background-radius: 8; -fx-border-radius: 8;" />
                                                    </children>
                                                </VBox>
                                                <VBox spacing="5.0" GridPane.columnIndex="1">
                                                    <children>
                                                        <Label text="LAST NAME" textFill="#7f8c8d" style="-fx-font-size: 11; -fx-font-weight: bold;" />
                                                        <TextField prefHeight="40.0" style="-fx-background-color: #f9f9f9; -fx-border-color: #e0e0e0; -fx-background-radius: 8; -fx-border-radius: 8;" />
                                                    </children>
                                                </VBox>
                                                <VBox spacing="5.0" GridPane.columnSpan="2" GridPane.rowIndex="1">
                                                    <children>
                                                        <Label text="COUNTRY" textFill="#7f8c8d" style="-fx-font-size: 11; -fx-font-weight: bold;" />
                                                        <SearchableComboBox fx:id="countryPicker" prefHeight="40.0" style="-fx-background-color: #f9f9f9;" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </GridPane>

                                        <Button prefHeight="45.0" prefWidth="150.0" style="-fx-background-color: #0052ff; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="Save Changes" />
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>

                    </children>
                </HBox>
            </center>
        </BorderPane>
    </children>
</AnchorPane>