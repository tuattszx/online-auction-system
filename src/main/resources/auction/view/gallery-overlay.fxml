<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="galleryOverlayRoot" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: rgba(244, 244, 244, 0.98);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="auction.client.controllers.GalleryOverlayController">
    <children>
        <HBox spacing="20.0" StackPane.alignment="CENTER">
            <children>

                <StackPane HBox.hgrow="ALWAYS">
                    <children>
                        <ScrollPane fx:id="imageScrollPane" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;" vbarPolicy="NEVER">
                            <content>
                                <StackPane fx:id="imageContainer">
                                    <children>
                                        <ImageView fx:id="expandedImageView" pickOnBounds="true" preserveRatio="true" />
                                    </children>
                                </StackPane>
                            </content>
                        </ScrollPane>

                        <Button mnemonicParsing="false" onAction="#handlePrevImage" style="-fx-background-color: white; -fx-background-radius: 50%; -fx-pref-width: 50; -fx-pref-height: 50; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 0); -fx-cursor: hand;" text="&lt;" StackPane.alignment="CENTER_LEFT">
                            <StackPane.margin>
                                <Insets left="20.0" />
                            </StackPane.margin>
                        </Button>

                        <Button mnemonicParsing="false" onAction="#handleNextImage" style="-fx-background-color: white; -fx-background-radius: 50%; -fx-pref-width: 50; -fx-pref-height: 50; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 0); -fx-cursor: hand;" text="&gt;" StackPane.alignment="CENTER_RIGHT">
                            <StackPane.margin>
                                <Insets right="20.0" />
                            </StackPane.margin>
                        </Button>
                    </children>
                </StackPane>

                <ScrollPane fx:id="thumbnailScrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="NEVER" prefWidth="180.0" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 0 1;">
                    <content>
                        <VBox fx:id="rightThumbnailContainer" alignment="TOP_CENTER" spacing="15.0">
                            <padding>
                                <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </HBox>
    </children>
</StackPane>
