<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="auction.client.controllers.MainViewController">
   <children>
      <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <fx:include fx:id="headerMenu" source="Header-menu.fxml" />

            <StackPane alignment="CENTER_RIGHT" maxHeight="80.0" prefHeight="80.0" prefWidth="1200.0" style="-fx-background-color: white; -fx-border-color: #eee; -fx-border-width: 0 0 1 0;">
               <children>
                  <ScrollPane fx:id="scrollCategories" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: white;" vbarPolicy="NEVER">
                     <content>
                        <HBox fx:id="categoryBar" alignment="CENTER" spacing="100.0" style="-fx-background-color: white; -fx-padding: 0 60 0 20;">
                           <children>
                              <VBox fx:id="vboxThisweek" alignment="CENTER" minWidth="80.0" onMouseClicked="#handleThisWeekClick" spacing="5" style="-fx-border-color: #0052ff; -fx-border-width: 0 0 3 0; -fx-cursor: hand;">
                                 <children>
                                    <Label style="-fx-text-fill: #0052ff;" text="⚖" textFill="#0052ff" />
                                    <Label style="-fx-font-weight: bold; -fx-text-fill: #0052ff;" text="%mainview.label.thisweek" textFill="#0052ff">
                                       <font>
                                          <Font name="System Bold" size="12.0" />
                                       </font></Label>
                                 </children>
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor>
                              </VBox>
                              <VBox alignment="CENTER" minWidth="80.0" onMouseClicked="#handleCategoryClick" spacing="5" style="-fx-cursor: hand;" userData="30003"><children><Label style="-fx-text-fill: #0052ff;" text="🖼" /><Label style="-fx-font-weight: bold; -fx-text-fill: #0052ff;" text="%mainview.label.art" /></children>
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor></VBox>
                              <VBox alignment="CENTER" minWidth="80.0" onMouseClicked="#handleCategoryClick" spacing="5" style="-fx-cursor: hand;" userData="30001"><children><Label style="-fx-text-fill: #0052ff;" text="🛋" /><Label style="-fx-font-weight: bold; -fx-text-fill: #0052ff;" text="%mainview.label.interiors" /></children>
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor></VBox>
                              <VBox alignment="CENTER" minWidth="80.0" onMouseClicked="#handleCategoryClick" spacing="5" style="-fx-cursor: hand;" userData="30004"><children><Label style="-fx-text-fill: #0052ff;" text="💎" /><Label style="-fx-font-weight: bold; -fx-text-fill: #0052ff;" text="%mainview.label.jewelry" /></children>
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor></VBox>
                              <VBox alignment="CENTER" minWidth="80.0" onMouseClicked="#handleCategoryClick" spacing="5" style="-fx-cursor: hand;" userData="60001"><children><Label style="-fx-text-fill: #0052ff;" text="⌚" /><Label style="-fx-font-weight: bold; -fx-text-fill: #0052ff;" text="%mainview.label.watch" /></children>
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor></VBox>
                              <VBox alignment="CENTER" minWidth="80.0" onMouseClicked="#handleCategoryClick" spacing="5" style="-fx-cursor: hand;" userData="60002"><children><Label style="-fx-text-fill: #0052ff;" text="👜" /><Label style="-fx-font-weight: bold; -fx-text-fill: #0052ff;" text="%mainview.label.fashion" /></children>
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor></VBox>
                              <VBox alignment="CENTER" minWidth="80.0" onMouseClicked="#handleCategoryClick" spacing="5" style="-fx-cursor: hand;" userData="60003"><children><Label style="-fx-text-fill: #0052ff;" text="✪" /><Label style="-fx-font-weight: bold; -fx-text-fill: #0052ff;" text="%mainview.label.coin" /></children>
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor></VBox>
                              <VBox alignment="CENTER" minWidth="80.0" onMouseClicked="#handleCategoryClick" spacing="5" style="-fx-cursor: hand;" userData="30002"><children><Label style="-fx-text-fill: #0052ff;" text="🚗" /><Label style="-fx-font-weight: bold; -fx-text-fill: #0052ff;" text="%mainview.label.car" /></children>
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor></VBox>
                              <VBox alignment="CENTER" minWidth="80.0" onMouseClicked="#handleCategoryClick" spacing="5" style="-fx-cursor: hand;" userData="60004"><children><Label style="-fx-text-fill: #0052ff;" text="🍷" /><Label style="-fx-font-weight: bold; -fx-text-fill: #0052ff;" text="%mainview.label.wine" /></children>
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor></VBox>
                              <VBox alignment="CENTER" minWidth="80.0" onMouseClicked="#handleCategoryClick" spacing="5" style="-fx-cursor: hand;" userData="60005"><children><Label style="-fx-text-fill: #0052ff;" text="📚">
                                       <font>
                                          <Font name="Nirmala UI" size="12.0" />
                                       </font></Label><Label style="-fx-font-weight: bold; -fx-text-fill: #0052ff;" text="%mainview.label.book" /></children>
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor></VBox>
                           </children>
                        </HBox>
                     </content>
                  </ScrollPane>

                                                      <HBox alignment="CENTER_RIGHT" maxHeight="80.0" minHeight="80.0" pickOnBounds="false" prefHeight="80.0" prefWidth="1200.0">
                     <children>
                        <StackPane mouseTransparent="false" onMouseClicked="#scrollRight" pickOnBounds="true" prefWidth="60.0" style="-fx-background-color: linear-gradient(to right, rgba(255,255,255,0), white); -fx-cursor: hand;">
                           <children>
                              <Label style="-fx-font-size: 18px; -fx-padding: 0 15 0 0; -fx-font-weight: bold;" text="▶" textFill="#0052ff" />
                           </children>
                        </StackPane>
                     </children>
                  </HBox>
               </children>
            </StackPane>

            <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0" style="-fx-background-color: #f8f9fa;">
               <padding><Insets left="25.0" right="25.0" /></padding>
               <children>
                  <Label style="-fx-font-weight: bold;" text="%mainview.label.sortby" textFill="#555" />
                  <ComboBox fx:id="sortPrice" prefHeight="35.0" prefWidth="150.0" promptText="%mainview.label.price" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5;" />
                  <ComboBox fx:id="sortTime" prefHeight="35.0" prefWidth="150.0" promptText="%mainview.label.time" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-radius: 5;" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label text="All products" textFill="#999" />
               </children>
            </HBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: #f1f3f5; -fx-background: #f1f3f5;" stylesheets="@../css/labelstatus.css" VBox.vgrow="ALWAYS">
               <content>
                  <FlowPane fx:id="flitems" alignment="TOP_CENTER" columnHalignment="CENTER" hgap="20.0" style="-fx-padding: 25;" vgap="25.0">
                     <children>
                        <VBox onMouseClicked="#onItemClick" prefWidth="260.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-cursor: hand;">
                           <children>
                              <StackPane>
                                 <children>
                                    <ImageView fitHeight="180.0" fitWidth="260.0" pickOnBounds="true" preserveRatio="false" style="-fx-background-radius: 10 10 0 0;">
                                       <image><Image url="@../img/images.jpg" /></image>
                                    </ImageView>
                                 </children>
                              </StackPane>
                              <VBox spacing="8.0" style="-fx-padding: 15;">
                                 <children>
                                    <HBox alignment="CENTER_LEFT">
                                       <children>
                                          <Label fx:id="itemName" prefHeight="28.0" prefWidth="199.0" style="-fx-font-weight: bold; -fx-font-size: 14px;" text="%mainview.label.ProductNameExample" wrapText="true" />
                                          <Label prefHeight="30.0" prefWidth="47.0" style="-fx-background-color: white; -fx-text-fill: red; -fx-background-radius: 20; -fx-padding: 5; -fx-translate-x: 15; -fx-translate-y: 0;" text="‪‪❤︎‬">
                                             <font>
                                                <Font size="18.0" />
                                             </font>
                                             <cursor>
                                                <Cursor fx:constant="HAND" />
                                             </cursor>
                                          </Label>
                                       </children>
                                    </HBox>
                                    <Label fx:id="itemPrice" style="-fx-font-weight: bold;" text="Current Bid: $1,200" textFill="#0052ff" />
                                    <Label style="-fx-font-size: 11px;" text="2d 04h left" textFill="#888" />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                  </FlowPane>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </children>
</AnchorPane>
