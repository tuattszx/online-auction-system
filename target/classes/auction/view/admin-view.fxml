<BorderPane prefHeight="750.0" prefWidth="1200.0" style="-fx-background-color: #f4f6f9;" stylesheets="@../css/admin.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="auction.client.controllers.AdminController">

    <left>
        <VBox fx:id="sidebar" prefWidth="260.0" spacing="10.0" style="-fx-background-color: #ffffff; -fx-border-color: #e9ecef; -fx-border-width: 0 1 0 0;">
