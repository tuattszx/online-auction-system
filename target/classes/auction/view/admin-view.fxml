                                    </VBox>

                                    <VBox prefHeight="140.0" prefWidth="250.0" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
