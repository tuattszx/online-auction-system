            </padding>
            <children>
                <HBox spacing="10.0">
                    <VBox.margin>
                        <Insets bottom="10.0" left="10.0" />
                    </VBox.margin>
                    <children>
                        <ImageView fitHeight="31.0" fitWidth="33.0" onMouseClicked="#toggleSidebar" pickOnBounds="true" preserveRatio="true" style="-fx-opacity: 0.7;">
                            <image>
                                <Image url="@../img/bagach.png" />
                            </image>
                        </ImageView>
                        <Label fx:id="lblAdminPanel" text="%adminview.label.adminpanel" textFill="#1a73e8">
                            <font>
                                <Font name="Segoe UI Bold" size="24.0" />
                            </font>
