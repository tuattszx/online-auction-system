                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="📦" />
                            <Label fx:id="txtApproveItems" style="-fx-text-fill: #495057; -fx-font-size: 14;" text="%adminview.label.productapproval" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnManageAuctions" alignment="BASELINE_LEFT" onAction="#handleManageAuctions" prefHeight="50.0" prefWidth="230.0">
