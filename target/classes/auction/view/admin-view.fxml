                    </children>
                </HBox>

                <Line fx:id="sideLine" endX="180.0" stroke="#e9ecef" />

                <Button fx:id="btnBack" alignment="BASELINE_LEFT" onAction="#handleBackToMain" prefHeight="45.0" prefWidth="230.0" style="-fx-background-color: transparent;">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label style="-fx-text-fill: #495057; -fx-font-size: 16;" text="←" />
                            <Label fx:id="txtBack" style="-fx-text-fill: #495057; -fx-font-size: 14;" text="%adminview.label.returnsystem" />
                        </HBox>
                    </graphic>
                    <VBox.margin><Insets bottom="20.0" top="10.0" /></VBox.margin>
                </Button>

                <Button fx:id="btnDashboard" alignment="BASELINE_LEFT" onAction="#handleShowDashboard" prefHeight="50.0" prefWidth="230.0">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="📊" />
                            <Label fx:id="txtDashboard" text="%adminview.label.overview" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnManageUsers" alignment="BASELINE_LEFT" onAction="#handleManageUsers" prefHeight="50.0" prefWidth="230.0">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="👥" />
                            <Label fx:id="txtManageUsers" style="-fx-text-fill: #495057; -fx-font-size: 14;" text="%adminview.label.usermanagement" />
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnApproveItems" alignment="BASELINE_LEFT" onAction="#handleApproveItems" prefHeight="50.0" prefWidth="230.0">
