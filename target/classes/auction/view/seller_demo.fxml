                                          <String fx:value="%sellerdemo.string.art" />
                                          <String fx:value="%sellerdemo.string.interiors" />
                                          <String fx:value="%sellerdemo.string.jewelry" />
                                          <String fx:value="%sellerdemo.string.watches" />
                                          <String fx:value="%sellerdemo.string.fashion" />
                                          <String fx:value="%sellerdemo.string.coins" />
                                          <String fx:value="%sellerdemo.string.cars" />
                                          <String fx:value="%sellerdemo.string.wine" />
                                          <String fx:value="%sellerdemo.string.books" />
                                      </FXCollections>
                                  </items>
                              </ComboBox>
                          </VBox>
      
                          <HBox spacing="10" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
