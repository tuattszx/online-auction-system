            <cursor>
               <Cursor fx:constant="HAND" />
            </cursor></Button>
            <Button fx:id="btnNavMyProducts" maxWidth="Infinity" onAction="#handleShowMyProducts" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-alignment: CENTER_LEFT;" text="%sellerdemo.button.myproduct">
            <cursor>
               <Cursor fx:constant="HAND" />
            </cursor></Button>
            <Button fx:id="btnNavCustomers" maxWidth="Infinity" onAction="#handleShowCustomers" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-alignment: CENTER_LEFT;" text="%sellerdemo.button.customers">
