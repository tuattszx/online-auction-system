                                          <Label style="-fx-font-weight: bold;" text="%sellerdemo.label.StartDateandTime" />
                                          <HBox alignment="CENTER_LEFT" spacing="10.0" VBox.vgrow="ALWAYS">
                                              <children>
                                                  <DatePicker fx:id="startDatePicker" prefWidth="150.0" promptText="%sellerdemo.datepicker.SelectDate" />
                                                  <Spinner fx:id="%sellerdemo.spinner.startHour" editable="true" initialValue="00" max="23" min="0" prefWidth="60.0" />
                                                  <Label text="h" />
                                                  <Spinner fx:id="%sellerdemo.spinner.startMinute" editable="true" initialValue="00" max="59" min="0" prefWidth="60.0" />
                                                  <Label text="m" />
                                                  <Spinner fx:id="%sellerdemo.spinner.startSecond" editable="true" initialValue="00" max="59" min="0" prefWidth="60.0" />
                                       <Label layoutX="329.0" layoutY="14.0" text="s" />
                                              </children>
                                          </HBox>
                                      </children>
                                  </VBox>

                                  <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="3" HBox.hgrow="ALWAYS">
                                      <children>
                                          <Label style="-fx-font-weight: bold;" text="%sellerdemo.label.EndDateandTime" />
                                          <HBox alignment="CENTER_LEFT" spacing="10.0" VBox.vgrow="ALWAYS">
                                              <children>
                                                  <DatePicker fx:id="endDatePicker" prefWidth="150.0" promptText="%sellerdemo.datepicker.SelectDate" />
                                                  <Spinner fx:id="%sellerdemo.spinner.endhour" editable="true" initialValue="00" max="23" min="0" prefWidth="60.0" />
                                                  <Label text="h" />
                                                  <Spinner fx:id="%sellerdemo.spinner.endminute" editable="true" initialValue="00" max="59" min="0" prefWidth="60.0" />
                                                  <Label text="m" />
                                                  <Spinner fx:id="%sellerdemo.spinner.endsecond" editable="true" initialValue="00" max="59" min="0" prefWidth="60.0" />
                                       <Label layoutX="329.0" layoutY="14.0" text="s" />
                                              </children>
                                          </HBox>
                                      </children>
                                  </VBox>
                              </children>
                              <padding>
                                  <Insets top="10.0" />
                              </padding>
                          </HBox>                          <VBox spacing="5" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="4">
                              <Label text="%sellerdemo.label.Description" />
                              <TextArea fx:id="txtDescription" prefHeight="100" promptText="%sellerdemo.textarea.Enterproductdetails" wrapText="true" />
                          </VBox>
      
                          <VBox alignment="CENTER" spacing="10" style="-fx-border-color: #bdc3c7; -fx-border-style: dashed; -fx-border-width: 2; -fx-border-radius: 5; -fx-padding: 20;" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="5">
                              <Label fx:id="lblFileName" text="%sellerdemo.label.draganddrop" textFill="#7f8c8d" />
                              <Button onAction="#handleBrowseFiles" style="-fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7;" text="%sellerdemo.button.BrowseFiles" />
                          </VBox>
                     <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" />
                        <RowConstraints />
                        <RowConstraints />
                     </rowConstraints>
                      </GridPane>
      
                      <HBox alignment="CENTER_RIGHT" spacing="10">
                          <Button onAction="#clearFields" prefWidth="100" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="%sellerdemo.button.Cancel" />
                          <Button onAction="#handleSaveProduct" prefWidth="100" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="%sellerdemo.button.Save" />
                      </HBox>
