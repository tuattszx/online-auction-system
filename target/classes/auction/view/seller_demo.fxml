                              <VBox spacing="5" HBox.hgrow="ALWAYS">
                                  <Label text="%sellerdemo.label.Width" />
                                  <TextField fx:id="txtWidth" promptText="cm" />
                              </VBox>
                          </HBox>
      
                          <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
                              <Label text="%sellerdemo.label.Weight" />
                              <TextField fx:id="txtWeight" promptText="kg" />
                          </VBox>
                          <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                              <Label text="%sellerdemo.label.Price" />
                              <TextField fx:id="txtPrice" promptText="\$0.00" />
                          </VBox>
